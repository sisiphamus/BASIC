{
  "name": "base-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base Academy: AI coaching through Meta glasses for Base Power field crews, with a master-electrician dashboard.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 'test/unit/**/*.test.js'",
    "test:e2e": "node --test --test-concurrency=1 'test/e2e/**/*.test.js'",
    "simulate": "node scripts/simulate.js",
    "check:gemini": "node scripts/check-gemini.js",
    "archive-data": "node scripts/archive-data.js",
    "tunnel": "npx -y cloudflared tunnel --url http://localhost:3000",
    "console": "node scripts/console.js",
    "frames": "node scripts/frames.js"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jpeg-js": "^0.4.4",
    "jsonrepair": "^3.15.0",
    "jsqr": "^1.4.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
