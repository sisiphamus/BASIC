# Copy to a file named .env next to this one and fill in. Restart the server after changes.

# Which model judges the photos: "claude-cli", "gemini" or "mock".
# Empty = Gemini if GEMINI_API_KEY is set, otherwise the built-in walkthrough model (no AI, for rehearsing).
MODEL_PROVIDER=claude-cli

# --- Claude (MODEL_PROVIDER=claude-cli) ---
# Uses the `claude` command-line tool (Claude Code) on this machine and whatever account it is logged
# into. No API key goes in this file. Run `claude` once to log in first.
# BA_CLAUDE_BIN=claude
# BA_CLAUDE_MODEL=sonnet
# BA_CLAUDE_EFFORT=low
# BA_CLAUDE_TIMEOUT_MS=30000

# --- Gemini (MODEL_PROVIDER=gemini) ---
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Empty = the server picks the newest stable "flash" model your key can use.
# GEMINI_MODEL=

# Ports: dashboard (http) and phone page (https, phones need https for the camera)
# PORT=3000
# HTTPS_PORT=3443

# Where jobs, frames and traces are saved (default ./data)
# DATA_DIR=./data

# How long the walkthrough model "thinks" per frame (ms)
# MOCK_DELAY_MS=700
