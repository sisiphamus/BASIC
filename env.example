# Copy to a file named .env next to this one and fill in. Restart the server after changes.

# Gemini API key from https://aistudio.google.com/apikey
# Leave empty to run the built-in walkthrough model (no AI, good for rehearsing the demo).
GEMINI_API_KEY=

# Pinned for the demo. Empty = the server picks the newest stable "flash" model your key can use.
GEMINI_MODEL=gemini-3.8-flash

# Force a model: "gemini" or "mock"
# MODEL_PROVIDER=

# Ports: dashboard (http) and phone page (https, phones need https for the camera)
# PORT=3000
# HTTPS_PORT=3443

# How long the walkthrough model "thinks" per frame (ms)
# MOCK_DELAY_MS=700
